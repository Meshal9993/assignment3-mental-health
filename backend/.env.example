# Copy to backend/.env only for a live demonstration. Never commit the real file.
MODEL_MODE=mock
OPENAI_API_KEY=
OPENAI_MODEL=
LIVE_CALL_LIMIT=50
# Independent, opt-in voice setup. These are server-only settings.
VOICE_ENABLED=false
VOICE_LIVE_MODEL=gpt-live-1
# Delegated Responses reasoning model; no tools or access to local records.
VOICE_BACKEND_MODEL=gpt-6-luna
# Voice duration is independent of the fixed 60-second breathing exercise.
VOICE_MAX_SESSION_SECONDS=300
